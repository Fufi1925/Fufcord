    <string name="setup3_title">Alles bereit!</string>
    <string name="setup3_text">Tippe START — deine Rich Presence läuft im Hintergrund, auch wenn die App zu ist. Bilder lädst du im Studio hoch.</string>
    <string name="setup3_finish">Los gehts</string>

