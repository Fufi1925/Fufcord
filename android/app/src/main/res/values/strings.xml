    <string name="setup1_test">Token testen</string>
    <string name="setup1_next">Weiter</string>
    <string name="setup2_badge">Schritt 2 · Bilder</string>
    <string name="setup2_title">Application ID</string>
    <string name="setup2_text">discord.com/developers → New Application → ID kopieren. Ohne ID funktioniert nur Text.</string>
