<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Fufcord „Clear" Theme — modern, schlicht, ruhig ============ -->
    <style name="Theme.Fufcord" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/violet_dark</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorTertiary">@color/success</item>
        <item name="colorError">@color/rose</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/Anim.Fufcord</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/card2</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Fufcord.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Fufcord.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Fufcord.Large</item>
    </style>

    <!-- Simple Übergänge überall (Fallback; explizites launch()/finish() gewinnt) -->
    <style name="Anim.Fufcord" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Voll-custom Dialog (Import): eigene Karte, eigene Animation -->
    <style name="Theme.Fufcord.Dialog" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/Anim.Fufcord.Dialog</item>
    </style>

    <style name="Anim.Fufcord.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <style name="Shape.Fufcord.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Fufcord.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.Fufcord.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Eingabefelder: komplett custom — 14dp-Form, Blurple-Rahmen bei Fokus -->
    <style name="Widget.Fufcord.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card2</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Fufcord.Input</item>
    </style>

    <style name="Shape.Fufcord.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Shape.Fufcord.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Buttons (backgroundTint @null = eigene flache Drawables, kein Farb-Mix) -->
    <style name="Widget.Fufcord.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Fufcord.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@null</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Fufcord.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Typografie (Basis-Stil, damit implizite Parents auflösen) -->
    <style name="Text.Fufcord" parent="android:Widget.Material.TextView">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Fufcord.H1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Fufcord.H2">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Fufcord.Section">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Text.Fufcord.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Fufcord.Caption">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Fufcord.Badge">
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>
