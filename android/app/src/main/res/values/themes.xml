<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fufcord" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blurple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pink</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Fufcord.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Fufcord.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Fufcord.Large</item>
    </style>

    <style name="Shape.Fufcord.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Shape.Fufcord.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.Fufcord.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
