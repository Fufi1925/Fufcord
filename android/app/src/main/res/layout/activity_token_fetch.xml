<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:id="@+id/btnFetchBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Zurück"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/text_primary" />
        </FrameLayout>

        <TextView
            style="@style/Text.Fufcord.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/fetch_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/card_glass_soft"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Text.Fufcord.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fetch_hint" />

        <TextView
            android:id="@+id/txtFetchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFetchCheck"
            style="@style/Widget.Fufcord.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/fetch_check"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_bolt"
            app:iconGravity="textStart"
            app:iconTint="@color/cyan" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/fetchProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/cyan"
        app:trackColor="@color/card2" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/card_glass"
        android:padding="8dp">

        <WebView
            android:id="@+id/webFetch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg" />
    </FrameLayout>
</LinearLayout>
