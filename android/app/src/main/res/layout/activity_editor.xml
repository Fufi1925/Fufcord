<?xml version="1.0" encoding="utf-8"?>
<!-- AURORA — Studio (Presence-Editor) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- ══════════ HERO ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:padding="12dp"
                android:text="🎨"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Aurora.HeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Studio" />

                <TextView
                    style="@style/Text.Aurora.HeroSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Jede Änderung sofort in der Vorschau" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/previewCard"
            layout="@layout/view_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <!-- ══════════ TEXT ══════════ -->
        <LinearLayout
            style="@style/Card.Aurora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Aurora.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Name" />

            <EditText
                android:id="@+id/etName"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="z.B. Minecraft"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Typ" />

            <Spinner
                android:id="@+id/spType"
                style="@style/Spin.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Details (Zeile 1)" />

            <EditText
                android:id="@+id/etDetails"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="z.B. ⛏️ Grinding Diamonds"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="State (Zeile 2)" />

            <EditText
                android:id="@+id/etState"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="z.B. Server: Fufcord SMP"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- ══════════ BILDER ══════════ -->
        <LinearLayout
            style="@style/Card.Aurora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Aurora.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bilder" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Großes Bild (Asset-Name)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etLarge"
                    style="@style/Input.Aurora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="z.B. logo"
                    android:inputType="text"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadLarge"
                    style="@style/Btn.Aurora.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="⬆ Hochladen" />
            </LinearLayout>

            <EditText
                android:id="@+id/etLargeText"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Hover-Text (optional)"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kleines Bild (Asset-Name)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSmall"
                    style="@style/Input.Aurora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="(leer = keins)"
                    android:inputType="text"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadSmall"
                    style="@style/Btn.Aurora.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="⬆ Hochladen" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSmallText"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Hover-Text (optional)"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☁️ Hochgeladene (antippen = übernehmen)"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshAssets"
                    style="@style/Btn.Aurora.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↻ Neu laden" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/assetList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ══════════ BUTTONS & EXTRAS ══════════ -->
        <LinearLayout
            style="@style/Card.Aurora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Aurora.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buttons &amp; Extras" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Stream-URL (nur bei Typ Streamt)" />

            <EditText
                android:id="@+id/etStream"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="https://twitch.tv/..."
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Button 1 (keine Emojis!)" />

            <EditText
                android:id="@+id/etBtn1Label"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="Text (leer = kein Button)"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etBtn1Url"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="https://..."
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Button 2" />

            <EditText
                android:id="@+id/etBtn2Label"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="Text (leer = kein Button)"
                android:inputType="text"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etBtn2Url"
                style="@style/Input.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="https://..."
                android:inputType="textUri"
                android:maxLines="1" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="44dp"
                android:text="⏱ Verstrichene Zeit anzeigen"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Online-Status" />

            <Spinner
                android:id="@+id/spStatus"
                style="@style/Spin.Aurora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                style="@style/Text.Aurora.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Party-Zähler" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPartyCur"
                    style="@style/Input.Aurora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:hint="aktuell (0 = aus)"
                    android:inputType="number"
                    android:maxLines="1" />

                <EditText
                    android:id="@+id/etPartyMax"
                    style="@style/Input.Aurora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:hint="max (0 = aus)"
                    android:inputType="number"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Btn.Aurora.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="✅ SPEICHERN" />
    </LinearLayout>
</ScrollView>
