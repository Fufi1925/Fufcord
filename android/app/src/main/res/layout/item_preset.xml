<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/preset_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minWidth="104dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <ImageView
            android:id="@+id/presetIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_img"
            android:contentDescription="Preset-Icon"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/presetLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/logo_badge_bg"
            android:gravity="center"
            android:text="P"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/presetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:text="Preset"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
