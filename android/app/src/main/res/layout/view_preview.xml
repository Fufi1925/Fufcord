<?xml version="1.0" encoding="utf-8"?>
<!-- 1:1 Discord-Aktivitätskarte in echten Discord-Farben -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/preview_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/discord_blurple" />

        <TextView
            android:id="@+id/previewType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:letterSpacing="0.06"
            android:text="SPIELT GERADE"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- Bilder: klein überlagert groß (wie bei Discord) -->
        <FrameLayout
            android:id="@+id/previewLargeWrap"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/rounded_img">

            <ImageView
                android:id="@+id/previewLarge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/previewLargeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="3"
                android:padding="6dp"
                android:text="🖼️"
                android:textColor="@color/discord_text"
                android:textSize="10sp" />

            <FrameLayout
                android:id="@+id/previewSmallWrap"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:background="@drawable/preview_small_bg">

                <ImageView
                    android:id="@+id/previewSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/previewSmallLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="@color/discord_text"
                    android:textSize="7sp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/previewName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fufcord"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/discord_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/previewState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/discord_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/previewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⏱ läuft seit Start"
                android:textColor="@color/mint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/previewBtnRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/previewBtn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/preview_btn_bg"
            android:gravity="center"
            android:padding="12dp"
            android:text="Button"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/previewBtn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/preview_btn_bg"
            android:gravity="center"
            android:padding="12dp"
            android:text="Button"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/previewSafe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🛡️ Sicher-Modus: nur Text"
        android:textColor="@color/mint"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
