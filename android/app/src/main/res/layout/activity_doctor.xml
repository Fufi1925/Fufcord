<?xml version="1.0" encoding="utf-8"?>
<!-- AURORA — Doktor (prüfen & reparieren) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- ══════════ HERO ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:padding="12dp"
            android:text="🩺"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Aurora.HeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doktor" />

            <TextView
                style="@style/Text.Aurora.HeroSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Prüft Token, App &amp; Bilder direkt bei Discord" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════ ERGEBNISSE ══════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/resultList"
            style="@style/Card.Aurora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <!-- ══════════ AKTIONEN ══════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFixAll"
        style="@style/Btn.Aurora.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="🔧 Alles automatisch reparieren" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoButtons"
            style="@style/Btn.Aurora.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="🔘 Buttons weg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoImages"
            style="@style/Btn.Aurora.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="🖼️ Bilder weg" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSafeToggle"
        style="@style/Btn.Aurora.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🛡️ Sicher-Modus" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Btn.Aurora.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zurück" />
</LinearLayout>
