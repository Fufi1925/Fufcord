<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_glass_soft"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/assetThumb"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/rounded_img"
        android:contentDescription="Asset-Bild"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/assetName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="logo"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnAssetDel"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/circle_icon_bg"
        android:contentDescription="@string/asset_del_title"
        android:padding="11dp"
        android:src="@drawable/ic_close"
        android:tint="@color/danger" />
</LinearLayout>
