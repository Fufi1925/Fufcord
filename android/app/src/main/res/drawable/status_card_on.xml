<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A34D399" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#231A3A"
                android:centerColor="#141B34"
                android:endColor="#0F2A33" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="#6634D399" />
        </shape>
    </item>
</layer-list>
