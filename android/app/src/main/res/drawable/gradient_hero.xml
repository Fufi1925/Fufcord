<?xml version="1.0" encoding="utf-8"?>
<!-- AURORA Hero: Verlauf + sanfter Licht-Schimmer oben -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/aurora_indigo"
                android:centerColor="@color/aurora_violet"
                android:endColor="@color/aurora_pink"
                android:angle="135" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
