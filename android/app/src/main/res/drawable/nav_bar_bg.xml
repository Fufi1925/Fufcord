<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass: schwebende Milchglas-Pille mit Glanz oben -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C8161B26" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#2E3850" />
        </shape>
    </item>
    <item android:bottom="28dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
